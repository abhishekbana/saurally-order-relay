# ====================================================
# saurally-order-relay – Environment Configuration
# ====================================================

# ----------------------------------------------------
# Core Paths
# ----------------------------------------------------
# Path inside container where logs are written
LOG_FILE=/data/logs/app.log

# Root directory for all persistent storage
DATA_DIR=/data/storage


# ----------------------------------------------------
# Mautic CRM Configuration
# ----------------------------------------------------
# Mautic API endpoint for contact upsert
# Example:
# https://mautic.example.com/api/contacts/new
MAUTIC_URL=https://mautic.example.com/api/contacts/new

# Mautic API credentials
MAUTIC_USER=your_mautic_username
MAUTIC_PASS=your_mautic_password


# ----------------------------------------------------
# Fast2SMS WhatsApp Configuration
# ----------------------------------------------------
# Base WhatsApp API URL
FAST2SMS_WHATSAPP_URL=https://www.fast2sms.com/dev/whatsapp

# Fast2SMS API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# WhatsApp Phone Number ID (constant for your account)
PHONE_NUMBER_ID=978583726384583


# ----------------------------------------------------
# WhatsApp Template IDs
# ----------------------------------------------------
# Order Received / Processing
MESSAGE_ID_ORDER_RECEIVED=56454

# Order Shipped / Completed
MESSAGE_ID_ORDER_SHIPPED=98743

# Order Shipped With Tracking
MESSAGE_ID_ORDER_SHIPPED_WITH_TRACKING=10121

# Abandoned Cart - ABC1
MESSAGE_ID_ABC1=78654

# ----------------------------------------------------
# Telegram Configuration
# ----------------------------------------------------
 TELEGRAM_BOT_TOKEN=88847326894:XXjdsnyubewelkhnruinajndyu45
 TELEGRAM_ENABLED=true
 TELEGRAM_CHAT_ID_ORDERS=-2283958012
 TELEGRAM_CHAT_ID_ABC=-3947586025

# ----------------------------------------------------
# Listmonk Configuration
# ----------------------------------------------------
LISTMONK_ENABLED=true
LISTMONK_URL=https://listmonk.example.com
LISTMONK_USER=admin
LISTMONK_PASS=secret
LISTMONK_LIST_ID_ABC=1
LISTMONK_LIST_ID_ORDERS=2

# ----------------------------------------------------
# Medusa Order Webhook
# ----------------------------------------------------
# Off by default. /medusa-order returns 503 until this is "true".
# Still being tested — flip on only when ready to go live.
MEDUSA_ORDER_ENABLED=false

# Shared secret used to verify X-Medusa-Signature (sha256=<hex hmac>) on
# every /medusa-order request. Requests without a valid signature are
# rejected with 401. Get the real value from whoever owns the Medusa side
# — never commit the actual secret.
ORDER_RELAY_SECRET=your_shared_secret_here
